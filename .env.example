# ============================================================================
# tross configuration template — copy to `.env` and edit; this file is a
# placeholder, it contains no real values. Every variable is optional; the
# values shown here are the built-in defaults from src/config.rs.
#
# SECRETS (treat as credentials; never commit the real `.env`):
#   LINKEDIN_COOKIE_HEADER, LINKEDIN_LI_AT, LINKEDIN_JSESSIONID,
#   LINKEDIN_EMAIL, LINKEDIN_PASSWORD, PROXY_URL (may embed proxy credentials)
#
# QUOTING: a value containing spaces must stay quoted so it is read as one
# value — e.g. USER_AGENT below. Values passed to the shell the same way
# (`export` or `docker run --env-file`) need identical quoting.
# ============================================================================

# --- service ---------------------------------------------------------------
APP_NAME=LinkedIn Profile API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000

# --- our API ---------------------------------------------------------------
# Comma-separated keys; empty means no auth (local only, REQUIRED in production).
API_KEYS=
CORS_ORIGINS=*
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
EXPOSE_RAW_ENDPOINT=false
MAX_REQUEST_BODY_BYTES=16384

# --- LinkedIn identity (SECRETS) -------------------------------------------
# Recommended: paste the whole Cookie header from a signed-in browser
# (DevTools → Network → request headers → Cookie).
LINKEDIN_COOKIE_HEADER=
# Alternative: the two cookies pulled out of that header.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
# Device/routing cookies that keep the li_at session alive — from the same
# browser cookie set. Optional but recommended; skip these if you use the
# whole LINKEDIN_COOKIE_HEADER above instead.
LINKEDIN_BCOOKIE=
LINKEDIN_B_SCOOKIE=
LINKEDIN_LIAP=
LINKEDIN_LIDC=
# Email/password login is off by default and risks challenges; enable only if
# you deliberately use it. Requires ALLOW_PASSWORD_LOGIN=true.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
ALLOW_PASSWORD_LOGIN=false
# Optional: Voyager query ID override; leave empty to auto-detect.
LINKEDIN_PROFILE_QUERY_ID=
SESSION_STATE_PATH=.cache/linkedin_session.json

# --- upstream client -------------------------------------------------------
# Quoted: the string contains spaces.
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
ACCEPT_LANGUAGE=en-US,en;q=0.9
VOYAGER_CLIENT_VERSION=1.13.30626
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.5
UPSTREAM_MIN_INTERVAL_SECONDS=1.2
UPSTREAM_JITTER_SECONDS=0.6
UPSTREAM_MAX_CONCURRENCY=4
CIRCUIT_BREAKER_THRESHOLD=4
CIRCUIT_BREAKER_COOLDOWN_SECONDS=90
# SECRET if it embeds proxy credentials; http(s)://, socks5://, socks5h://
PROXY_URL=

# --- cache -----------------------------------------------------------------
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=512
CACHE_DIR=.cache/profiles
CACHE_PERSIST=true

# --- proxies ---------------------------------------------------------------
# Comma-separated; empty means trust the direct peer. Set when behind a
# reverse proxy or load balancer.
TRUSTED_PROXIES=
